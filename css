*{
    padding: 0;
    margin: 0;
}
nav{
    width: 100%;
    display: flex;
    height: 70px;
    /* justify-content: center;  */
    background-color:rgba(26, 91, 170, 0.312);
    border-radius: 15px;
    align-items: center;
    justify-content: space-between;
    box-sizing:border-box;
    gap: 10px;
    
}
nav a{
    text-decoration: none;
    color: black;
    font-size: 25px;
    font-weight: 500px;
}
nav button{
    height: 35px;
    width: 130px;
    background-color: blue;
    color: white;
    border-radius: 20px;
    margin-right: 150px;   
}
nav img{
    height: 40px;
    width: 60px;
    border-radius: 10px;
    background-color:white;
    margin-left: 100px;
}
.home{
    height: 500px;
    background-repeat: no-repeat;
}
.home img{
    height: 600px;
    /* padding-top: 70px; */
    width: 100%;
    position:relative;
} 
.content{
    position: absolute;
    top:50%;
    left: 90px;
}
  .home h1{
    /* position: absolute;
    top:50%;
    left: 90px; */
    color:navy;
    font-size: 60px;
}
.home h4{
    
    left: 90px;
    font-weight: normal;
    font-size: 30px;
    color: navy;
} 
.home button{
    top: 70%;
    left: 90px;
    border-radius: 20px;
    height: 40px;
    width: 140px;
    background-color: darkblue;
    color: white;
    border: white 2px solid;
} 
.content button{
    margin-left: 30px;
}
.content button:hover{
    background-color: brown;
    color: white;
    transform: scale(1.1);

}
.h2{
    height: 100px;
    padding-top: 100px;
    padding-left: 100px;
    background-color:skyblue;
    text-align: center;
    font-size: 50px;
    color: white;
}
.doc1{
    padding-top: 10px;
    margin-top: 0px;
    /* padding-left: 200px; */
    display: grid;
    grid-template-rows: repeat(2,1fr);
    grid-template-columns: repeat(3,1fr);
    row-gap: 30px;
    column-gap: 90px;
    width: 400px;
    height: 700px;
}
.indoc{
    padding-top: 50px;
    margin-top: 0px;
     padding-left: 250px;
    margin-right: 100px;
    display: grid;
    grid-template-rows: repeat(2,1fr);
    grid-template-columns: repeat(3,1fr);
    row-gap: 30px;
    column-gap: 90px;
}
.doc{
    width: 280px;
    height: 300px;
    border-radius: 20px;
    border: white 2px solid;
    box-shadow:rgba(0, 0, 0, 0.403) 5px 5px 3px 5px ;
    padding-left: 10px;
}
.doc img{
    border-radius: 30px;
    padding-left: 50px;
    padding-top: 20px;
    height: 200px;
    width: 200px;
}
.doc h4{
    padding-top: 10px;
   padding-left: 70px;
}
.doc p{
    padding-left: 70px;
}
.doc button{
    margin-left: 70px;
    border-radius: 20px;
    height: 30px;
    width: 100px;
    background-color: darkblue;
    color: white;
    border: white;
}
.doc:hover{
    transform: scale(1.1);
    background-color: magenta;
    color: white;
}
.doc button:hover{
    transform: scale(1.1);
    background-color: maroon;
    color: white;

}
.last{
    margin-top: 30px;
    width: 100vw;
    height: 100px;
    background-color:skyblue;
    color: white;
    text-align: center;
}
.last button{
    height: 40px;
    width: 150px;
    background-color:blue;
    color: white;
    border-radius: 20px;
    /* padding: 20px; */
    
}
.foot{
    width: 100vw;
    display: flex;
    gap: 80px;
    margin-left: 0px;
    background-color: navy;
    
}
.foot1{
    height: 300px;
    width: 200px;
    line-height: 40px;
    color: white;
    padding-left: 100px;
    
}
.foot1 h4{
   font-weight: normal;
}
.foot1 button{
    padding: 15px;
    border-radius: 20px;
    background-color:blue;
    color: white;
}